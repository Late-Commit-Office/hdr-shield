/* HDR Shield — 简体中文。
   键必须与 en.lproj 完全一致；可以用 `bash scripts/check-strings.sh` 检查。
   中文文字使用全角标点。 */

/* 菜单顶部的状态行，也是提示文字的开头 */
"status.on" = "HDR 高光：遮光中";
"status.off" = "HDR 高光：正常";

/* 菜单栏图标的提示文字。%@ = 上面的某一条状态 */
"tooltip.format" = "%@（点击切换，右键菜单）";

/* 菜单项 */
"menu.launchAtLogin" = "登录时启动";
"menu.quit" = "退出 HDR Shield";

/* 无法更改登录项时弹出的提示。系统的错误信息会附在说明文字下方 */
"loginItem.error.title" = "无法更改登录项";
"loginItem.error.message" = "请先把 HDR Shield.app 移到「应用程序」文件夹再试。";
